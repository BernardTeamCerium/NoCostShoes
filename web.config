<?xml version="1.0" encoding="utf-8"?>
<!--
  www.nocostshoes.com - redirects for the 2026 redesign (softgait/NoCostShoes, flat .html pages).
  Put this file in the site root next to index.html. Needs the IIS URL Rewrite module (installed on the Softgait server).
  Every rule is a permanent (301) redirect so search engines move the old page's ranking to the new page.
  Matching ignores upper/lower case, and folder addresses work with or without a trailing "/index.html".
  Prepared 2026-11-12 from: the current live site (October WordPress export), addresses search engines still list,
  and the October dead-link list.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Pages of the October 2026 site (live until the redesign is deployed) -->
        <rule name="2025 home" stopProcessing="true">
          <match url="^home(/(index\.html)?)?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="2025 about" stopProcessing="true">
          <match url="^(about-us|about)(/(index\.html)?)?$" />
          <action type="Redirect" url="/about.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 mens" stopProcessing="true">
          <match url="^all-mens-shoes(/(index\.html)?)?$" />
          <action type="Redirect" url="/mens-shoes.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 womens" stopProcessing="true">
          <match url="^all-womens-shoes(/(index\.html)?)?$" />
          <action type="Redirect" url="/womens-shoes.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 careers" stopProcessing="true">
          <match url="^(careers|new-career)(/(index\.html)?)?$" />
          <action type="Redirect" url="/careers.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 compression" stopProcessing="true">
          <match url="^compression-garments(/(index\.html)?)?$" />
          <action type="Redirect" url="/compression.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 cgm" stopProcessing="true">
          <match url="^(continuous-glucose-monitors(/(index\.html)?)?|continuous-glucose-monitoring\.php)$" />
          <action type="Redirect" url="/cgm.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 contact" stopProcessing="true">
          <match url="^(contact|contact-us)(/(index\.html)?)?$" />
          <action type="Redirect" url="/contact.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 how it works" stopProcessing="true">
          <match url="^how-it-works(/(index\.html)?)?$" />
          <action type="Redirect" url="/how-it-works.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 patients" stopProcessing="true">
          <match url="^patients(/(index\.html)?)?$" />
          <action type="Redirect" url="/patients.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 providers" stopProcessing="true">
          <match url="^providers(/(index\.html)?)?$" />
          <action type="Redirect" url="/providers.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 medicare guide" stopProcessing="true">
          <match url="^medicare-coverage-guide(/(index\.html)?)?$" />
          <action type="Redirect" url="/resources.html#medicare-guide" redirectType="Permanent" />
        </rule>
        <rule name="2025 faqs" stopProcessing="true">
          <match url="^(resources/faqs(/(index\.html)?)?|faq|faqs)$" />
          <action type="Redirect" url="/resources.html#faqs" redirectType="Permanent" />
        </rule>
        <rule name="2025 shoe bill" stopProcessing="true">
          <match url="^resources/therapeutic-shoe-bill(/(index\.html)?)?$" />
          <action type="Redirect" url="/resources.html#shoe-bill" redirectType="Permanent" />
        </rule>
        <rule name="2025 foot care" stopProcessing="true">
          <match url="^resources/foot-care(/(index\.html)?)?$" />
          <action type="Redirect" url="/patients.html" redirectType="Permanent" />
        </rule>
        <rule name="2025 resources" stopProcessing="true">
          <match url="^resources(/.*)?$" />
          <action type="Redirect" url="/resources.html" redirectType="Permanent" />
        </rule>

        <!-- 2. Older generations still listed by search engines -->
        <rule name="old womens" stopProcessing="true">
          <match url="^(view-all-women|women|dr-comfort-womens-diabetic-shoes(\.php|/.*)?|apex-womens-diabetic-shoes(\.php|/.*)?|products/women-.*)/?$" />
          <action type="Redirect" url="/womens-shoes.html" redirectType="Permanent" />
        </rule>
        <rule name="old mens" stopProcessing="true">
          <match url="^(view-all-men-shoes|men|dr-comfort-mens-diabetic-shoes(\.php|/.*)?|apex-mens-diabetic-shoes(\.php|/.*)?|products/men-.*)/?$" />
          <action type="Redirect" url="/mens-shoes.html" redirectType="Permanent" />
        </rule>
        <rule name="old qualify" stopProcessing="true">
          <match url="^(do-i-qualify\.html|do-i-qualify|apply-now|thank-you-eligibility)/?$" />
          <action type="Redirect" url="/qualify.html" redirectType="Permanent" />
        </rule>
        <rule name="old blog" stopProcessing="true">
          <match url="^(blog|blog/.*|post/.*|blog-categories/.*)$" />
          <action type="Redirect" url="/resources.html" redirectType="Permanent" />
        </rule>
        <rule name="old privacy" stopProcessing="true">
          <match url="^(privacy-policy|privacy)/?$" />
          <action type="Redirect" url="/privacy.html" redirectType="Permanent" />
        </rule>
        <rule name="old terms" stopProcessing="true">
          <match url="^(terms|terms-and-conditions|terms-of-use)/?$" />
          <action type="Redirect" url="/terms.html" redirectType="Permanent" />
        </rule>
        <rule name="old landing pages" stopProcessing="true">
          <match url="^(good-shoes-for-diabetics|prescription-diabetic-shoes-near-me|back-brace-medicare\.php)/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- 3. Housekeeping -->
        <rule name="root index.html" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^GET$" /></conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="extensionless pages" stopProcessing="true">
          <!-- /about serves /about.html without changing the address -->
          <match url="^([a-z0-9-]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
